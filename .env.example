# docker compose variables (used for interpolation + the api container)
POSTGRES_USER=albbas
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=albbas

# Public origin for the web app (SSR)
ORIGIN=https://albbas.mateakos.com

# --- api env (loaded via env_file) ---
NODE_ENV=production
APP_URL=https://albbas.mateakos.com
SESSION_SECRET=change-me-to-a-long-random-string-32-chars-min
SESSION_TTL_DAYS=30
MAX_UPLOAD_BYTES=26214400
UPLOAD_RATE_LIMIT_PER_HOUR=200

# Storage backend: s3 (Supabase) or local
STORAGE_BACKEND=s3
LOCAL_STORAGE_DIR=./data/uploads

# Supabase S3-compatible storage
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=true

# Initial admin account (seeded once, only when no users exist)
ADMIN_EMAIL=you@mateakos.com
ADMIN_PASSWORD=

# DATABASE_URL and REDIS_URL are set by docker-compose (service hostnames)
