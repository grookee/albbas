{
  "name": "@albbas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./router": "./src/routers/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@albbas/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.734.0",
    "@aws-sdk/lib-storage": "^3.734.0",
    "@fastify/multipart": "^9.0.3",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.3.1",
    "@trpc/server": "^11.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "prisma": "^6.3.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
