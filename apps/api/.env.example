NODE_ENV=development
HOST=0.0.0.0
PORT=3001
APP_URL=http://localhost:5173

DATABASE_URL=postgresql://albbas:albbas@localhost:5433/albbas
SESSION_SECRET=change-me-to-a-long-random-string-32-chars-min
# used to encrypt api keys at rest so uploader configs can be re-downloaded
ENCRYPTION_KEY=change-me-to-a-long-random-string-32-chars-min

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/uploads

# S3 / Supabase storage (unused while STORAGE_BACKEND=local)
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

MAX_UPLOAD_BYTES=26214400
PASTE_MAX_BYTES=8388608
UPLOAD_RATE_LIMIT_PER_HOUR=200

REDIS_URL=redis://localhost:6379

# Seeded once when the users table is empty
ADMIN_EMAIL=you@mateakos.com
ADMIN_PASSWORD=
